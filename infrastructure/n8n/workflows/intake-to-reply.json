      "id": "job-done",
      "name": "Job done",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Job done",
              "leftValue": "={{ $json.status === 'done' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",

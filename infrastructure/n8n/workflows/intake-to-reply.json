    {
      "id": "stop-failed-job",
      "name": "Stop failed job",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        2640,
        240
      ],
      "parameters": {
        "errorMessage": "Ask job failed; no reply sent"

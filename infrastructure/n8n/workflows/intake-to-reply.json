    {
      "id": "prepare-draft",
      "name": "Prepare draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "const classification = $('Validate classification').first().json;\nlet text;\nif ($json.status === 'done') {\n  const r = $json.result;\n  if (!r || typeof r.found !== 'boolean') throw new Error('Missing job result');\n  if (r.found) {\n    if (typeof r.answer !== 'string' || !r.answer.trim() || !Array.isArray(r.citations) || !r.citations.length) throw new Error('Answer requires citations');\n    const citations = r.citations.map(c => {\n      if (!Number.isInteger(c.n) || !Number.isInteger(c.page) || c.page < 1 || typeof c.source !== 'string' || !c.source.trim()) throw new Error('Invalid citation');\n      return `[${c.n}] ${c.source} — trang ${c.page}`;\n    });\n    text = r.answer + '\\n\\nNguồn:\\n' + citations.join('\\n');\n  } else text = 'Chưa tìm thấy thông tin phù hợp trong tài liệu. Vui lòng liên hệ nhân viên để được hỗ trợ.';\n} else if (classification.needs_human || ['complaint','request'].includes(classification.intent)) {\n  text = 'Yêu cầu cần nhân viên xử lý trực tiếp. Vui lòng liên hệ bộ phận hỗ trợ ngân hàng qua kênh chính thức.';\n} else text = 'Vui lòng gửi câu hỏi về sản phẩm, phí hoặc thủ tục ngân hàng để được tra cứu tài liệu.';\nreturn [{json: {text, intent: classification.intent, needs_human: classification.needs_human}}];"
      }
    },
    {
      "id": "review-draft",
      "name": "Review draft",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "operation": "sendAndWait",
        "fromEmail": "assistant@example.test",
        "toEmail": "approver@example.test",
        "subject": "[Bank Assistant] Duyệt phản hồi",
        "message": "={{ ('Gửi tới: ' + $('Validate intake').first().json.email + '\\nCâu hỏi: ' + $('Validate intake').first().json.message + '\\nIntent: ' + $json.intent + '\\nNeeds human: ' + $json.needs_human + '\\n\\n' + $json.text).replaceAll('&', '&#38;').replaceAll('<', '&#60;').replaceAll('>', '&#62;') }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Duyệt gửi",
            "disapproveLabel": "Từ chối"
          }
        },
        "options": {

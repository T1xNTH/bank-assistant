{
  "id": "bankIntakeToReply",
  "name": "Bank Assistant - intake to reply",
  "active": false,
  "nodes": [
    {
      "id": "intake-form",
      "name": "Intake form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Bank Assistant",
        "formDescription": "Gửi câu hỏi để được kiểm tra tài liệu và duyệt phản hồi. Chỉ dùng dữ liệu mẫu trong môi trường local.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {"path": "bank-intake"}
      },
      "webhookId": "b90dff25-7677-4540-8d6b-e9aab770d033"
    },
    {
      "id": "validate-intake",
      "name": "Validate intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const email = String($json.Email ?? '').trim();\nconst message = String($json.Message ?? '').trim();\nif (!/^[^\\s@<>,;\\r\\n]+@[^\\s@<>,;\\r\\n]+\\.[^\\s@<>,;\\r\\n]+$/.test(email) || email.length > 254) throw new Error('Invalid single recipient');\nif (!message || message.length > 2000) throw new Error('Message must contain 1-2000 characters');\nreturn [{json: {email, message}}];"
      }
    },
    {
      "id": "classify",
      "name": "Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "http://api:8000/chat",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { message: $('Validate intake').first().json.message } }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bank-public-service",
          "name": "Bank Assistant public service"
        }
      }
    },
    {
      "id": "validate-classification",
      "name": "Validate classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "if (!['question','complaint','request','other'].includes($json.intent) || typeof $json.needs_human !== 'boolean') throw new Error('Invalid classification');\nreturn $input.all();"
      }
    },
    {
      "id": "document-question",
      "name": "Document question",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Document question",
              "leftValue": "={{ $json.intent === 'question' && $json.needs_human === false }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "enqueue",
      "name": "Enqueue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "http://api:8000/ask/jobs",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { question: $('Validate intake').first().json.message } }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bank-public-service",
          "name": "Bank Assistant public service"
        }
      }
    },
    {
      "id": "poll-budget",
      "name": "Poll budget",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "if ($runIndex >= 60) throw new Error('Job polling timed out');\nreturn $input.all();"
      }
    },
    {
      "id": "wait-for-job",
      "name": "Wait for job",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "webhookId": "ad04db3a-8716-4a8f-bb44-ef171fe0d033"
    },
    {
      "id": "poll-job",
      "name": "Poll job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "url": "={{ 'http://api:8000/ask/jobs/' + encodeURIComponent($('Enqueue').first().json.job_id) }}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bank-public-service",
          "name": "Bank Assistant public service"
        }
      }
    },
    {
      "id": "validate-job",
      "name": "Validate job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "if (!['queued','running','done','failed'].includes($json.status)) throw new Error('Invalid job status');\nreturn $input.all();"
      }
    },

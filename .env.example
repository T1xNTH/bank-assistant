# Copy to .env.local (git-ignored). Never commit real values.
RAG_BACKEND=fake
LLM_BACKEND=fake
AUTH_BACKEND=fake
OPENAI_API_KEY=
# Bare provider model ID; Compose adds the openai/ prefix for LiteLLM.
OPENAI_MODEL=gpt-6-luna
# Gateway alias for the future eval adapter (T-023), not a bare provider model ID.
JUDGE_MODEL=cloud-chat
# Judge for answers routed local (confidential chunks); must be a local-* alias, never cloud.
JUDGE_LOCAL_MODEL=local-chat
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bank_docs
# dense | hybrid | hybrid_rerank; blank = hybrid_rerank (docs/07-development/answer.md).
RETRIEVAL_MODE=hybrid_rerank
# Rerank score in [0, 1] below which a chunk is dropped; blank = 0.5 (docs/07-development/rerank.md).
REFUSAL_THRESHOLD=
# Hybrid results the reranker rescores; blank = 5.
RERANK_CANDIDATES=
LLM_BASE_URL=http://127.0.0.1:4000
# Required for Compose: generate with python -c "import secrets; print('sk-'+secrets.token_hex(32))".
LITELLM_MASTER_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_MAX_LENGTH=100
QUEUE_WAITING_TTL=3600
# Shared /ask, /chat and /ask/jobs token bucket per API key (fake auth without a key uses user ID).
# RPM is the refill rate; BURST is the bucket capacity. Redis failure returns 503.
API_KEY_RPM=60
API_KEY_BURST=10
# Global worker execution-attempt bucket: one token capacity, shared across workers.
WORKER_RPM=60
WORKER_MAX_ATTEMPTS=4
WORKER_BACKOFF_SECONDS=1
WORKER_JOB_TIMEOUT=600
API_KEYS_FILE=config/api_keys.json
AUDIT_DB_PATH=data/audit.db
# Agent threads (LangGraph SQLite checkpointer, T-030); holds masked messages only.
AGENT_CHECKPOINT_DB_PATH=data/agent_checkpoints.db
# Streamlit demo UI (make ui, T-042). Raw API keys from scripts/make_key.py; a blank key hides that role.
UI_API_URL=http://127.0.0.1:8000
UI_KEY_CREDIT_STAFF=
UI_KEY_HR_STAFF=
UI_KEY_APPROVER=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
# Optional local obs profile: create keys with pk-lf-/sk-lf- prefixes, then restart api/worker.
LANGFUSE_ADMIN_EMAIL=
LANGFUSE_ADMIN_PASSWORD=
# Local-only defaults exist in compose; replace these before sharing the deployment.
LANGFUSE_DB_PASSWORD=
LANGFUSE_AUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_S3_PASSWORD=
COMPOSE_PROFILES=
# Set COMPOSE_PROFILES=local-llm to start Ollama; pull models as documented.
# Add automation (comma-separated with other profiles) for n8n :5678 and Mailpit :8025.
# Setup public/service credentials and import: docs/11-integrations/n8n.md.

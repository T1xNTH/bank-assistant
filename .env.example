# Copy to .env.local (git-ignored). Never commit real values.
RAG_BACKEND=fake
LLM_BACKEND=fake
AUTH_BACKEND=fake
OPENAI_API_KEY=
# Bare provider model ID; Compose adds the openai/ prefix for LiteLLM.
OPENAI_MODEL=gpt-6-luna
# Gateway alias for the future eval adapter (T-023), not a bare provider model ID.
JUDGE_MODEL=cloud-chat
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bank_docs
# dense | hybrid | hybrid_rerank; blank = hybrid_rerank (docs/07-development/answer.md).
RETRIEVAL_MODE=hybrid_rerank
# Rerank score in [0, 1] below which a chunk is dropped; blank = 0.5 (docs/07-development/rerank.md).
REFUSAL_THRESHOLD=
# Hybrid results the reranker rescores; blank = 5.
RERANK_CANDIDATES=
LLM_BASE_URL=http://127.0.0.1:4000
# Required for Compose: generate with python -c "import secrets; print('sk-'+secrets.token_hex(32))".
LITELLM_MASTER_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_MAX_LENGTH=100
API_KEYS_FILE=config/api_keys.json
AUDIT_DB_PATH=data/audit.db
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
COMPOSE_PROFILES=
# Set COMPOSE_PROFILES=local-llm to start Ollama; pull models as documented.

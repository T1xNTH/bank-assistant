# Copy to .env.local (git-ignored). Never commit real values.
RAG_BACKEND=fake
LLM_BACKEND=fake
AUTH_BACKEND=fake
OPENAI_API_KEY=
# Bare provider model ID; Compose adds the openai/ prefix for LiteLLM.
OPENAI_MODEL=gpt-6-luna
JUDGE_MODEL=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bank_docs
RETRIEVAL_MODE=hybrid_rerank
REFUSAL_THRESHOLD=
LLM_BASE_URL=http://127.0.0.1:4000
# Required for Compose: generate with python -c "import secrets; print('sk-'+secrets.token_hex(32))".
LITELLM_MASTER_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
API_KEYS_FILE=config/api_keys.json
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
COMPOSE_PROFILES=
# Set COMPOSE_PROFILES=local-llm to start Ollama; pull models as documented.
